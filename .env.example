# IGDB application access, registered through the Twitch Developer Console.
# Copy values into .env locally. Never commit real credentials.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Local account development: node scripts/setup-dev.mjs generates these safely.
POSTGRES_PASSWORD=
DATABASE_URL=
SESSION_SECRET=
APP_ORIGIN=http://127.0.0.1:4200
# PORT=3000
# Enable only for a reverse proxy connecting from loopback:
# TRUST_PROXY_LOOPBACK=true
