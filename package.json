{
  "name": "game-tracker",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^26.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --import tsx apps/api/src/main.ts",
    "dev:web": "ng serve web --host 127.0.0.1 --port 4200",
    "build": "npm run build:api && ng build web",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/api/main.js",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit && ngc -p apps/web/tsconfig.json --noEmit && tsc -p tests/tsconfig.json",
    "format": "prettier --write apps tests scripts/*.ts scripts/setup-dev.mjs *.json .postcssrc.json *.ts *.yaml AGENTS.md README.md docs/development.md docs/database-migrations.md",
    "format:check": "prettier --check apps tests scripts/*.ts scripts/setup-dev.mjs *.json .postcssrc.json *.ts *.yaml AGENTS.md README.md docs/development.md docs/database-migrations.md",
    "db:up": "docker compose up -d --wait db",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "test:api": "node --import tsx --test --test-concurrency=1 tests/*.http.test.ts",
    "test:browser": "npm run build && playwright test",
    "test": "npm run test:api && npm run test:browser",
    "catalog:validate": "node --env-file-if-exists=.env --import tsx scripts/validate-catalog.ts",
    "db:status": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts status",
    "db:generate": "node --env-file-if-exists=.env --import tsx node_modules/typeorm/cli.js migration:generate -d scripts/typeorm-data-source.ts",
    "db:migrate:built": "node --env-file-if-exists=.env dist/api/database/cli.js",
    "discovery:validate": "node --env-file-if-exists=.env --import tsx scripts/validate-discovery.ts",
    "account:reset": "node --env-file-if-exists=.env --import tsx apps/api/src/accounts/reset.cli.ts"
  },
  "dependencies": {
    "@angular/common": "~22.2.3",
    "@angular/compiler": "~22.2.3",
    "@angular/core": "~22.2.3",
    "@angular/forms": "~22.2.3",
    "@angular/platform-browser": "~22.2.3",
    "@angular/router": "~22.2.3",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/typeorm": "12.0.2",
    "argon2": "^0.44.0",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "1.1.2"
  },
  "devDependencies": {
    "@angular/build": "~22.2.3",
    "@angular/cli": "~22.2.3",
    "@angular/compiler-cli": "~22.2.3",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/node": "^26.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.15.5",
    "concurrently": "^9.2.1",
    "embedded-postgres": "17.10.0-beta.17",
    "postcss": "^8.5.31",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "~6.0.0"
  },
  "type": "module"
}
