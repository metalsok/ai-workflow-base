{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "../../dist/web-ts",
    "lib": ["ES2023", "DOM"],
    "types": [],
    "isolatedModules": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false
  },
  "angularCompilerOptions": {
    "strictTemplates": true,
    "strictInjectionParameters": true
  },
  "include": ["src/**/*.ts"]
}
